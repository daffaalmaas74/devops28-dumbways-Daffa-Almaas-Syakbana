pipeline {
    agent any

    stages {
        stage('Testing Quality Code') {
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner'

                    withSonarQubeEnv('sonarqube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=fe-dumbmerch-production \
                                -Dsonar.sources=.
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Pull Source Code') {
            steps {
                sshagent(['global-ssh']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no \
                            -p 3333 \
                            finaltask-daffaalmaas@20.213.139.187 << 'EOF'

                        set -e

                        cd /home/finaltask-daffaalmaas/fe-dumbmerch

                        git pull origin production
EOF
                    '''
                }
            }
        }

        stage('Build Image') {
            steps {
                sshagent(['global-ssh']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no \
                            -p 3333 \
                            finaltask-daffaalmaas@20.213.139.187 << 'EOF'

                        set -e

                        cd /home/finaltask-daffaalmaas/fe-dumbmerch

                        docker build \
                            -t registry.daffaalmaas.studentdumbways.my.id/fe-dumbmerch:production \
                            .
EOF
                    '''
                }
            }
        }

        stage('Scan Image') {
            steps {
                sshagent(['global-ssh']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no \
                            -p 3333 \
                            finaltask-daffaalmaas@20.213.139.187 << 'EOF'

                        set -e

                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest \
                            image \
                            --severity HIGH,CRITICAL \
                            registry.daffaalmaas.studentdumbways.my.id/fe-dumbmerch:production
EOF
                    '''
                }
            }
        }

        stage('Push Image') {
            steps {
                sshagent(['global-ssh']) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'registry-credentials',
                            usernameVariable: 'REGISTRY_USERNAME',
                            passwordVariable: 'REGISTRY_PASSWORD'
                        )
                    ]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no \
                                -p 3333 \
                                finaltask-daffaalmaas@20.213.139.187 << 'EOF'

                            set -e

                            echo "${REGISTRY_PASSWORD}" | docker login \
                                registry.daffaalmaas.studentdumbways.my.id \
                                -u "${REGISTRY_USERNAME}" \
                                --password-stdin

                            docker push \
                                registry.daffaalmaas.studentdumbways.my.id/fe-dumbmerch:production
EOF
                        """
                    }
                }
            }
        }

        stage('Deploy To K3s Cluster') {
            steps {
                sshagent(['global-ssh']) {
                    withCredentials([
                        string(
                            credentialsId: 'user-password',
                            variable: 'USER_PASSWORD'
                        )
                    ]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no \
                                -p 3333 \
                                finaltask-daffaalmaas@20.213.139.187 << 'EOF'

                            set -e

                            printf '%s\\n' "${USER_PASSWORD}" | sudo -S -p '' -v

                            cd /home/finaltask-daffaalmaas/fe-dumbmerch

                            sudo kubectl apply \
                                -f deployment.yaml \
                                -f service.yaml

                            sudo kubectl -n frontend set image \
                                deployment/fe-dumbmerch \
                                fe-dumbmerch=registry.daffaalmaas.studentdumbways.my.id/fe-dumbmerch:production

                            sudo kubectl -n frontend rollout restart \
                                deployment/fe-dumbmerch
EOF
                        """
                    }
                }
            }
        }

        stage('Testing Running Application On K3s Cluster') {
            steps {
                sshagent(['global-ssh']) {
                    withCredentials([
                        string(
                            credentialsId: 'user-password',
                            variable: 'USER_PASSWORD'
                        )
                    ]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no \
                                -p 3333 \
                                finaltask-daffaalmaas@20.213.139.187 << 'EOF'

                            set -e

                            printf '%s\\n' "${USER_PASSWORD}" | sudo -S -p '' -v

                            sudo kubectl -n frontend rollout status \
                                deployment/fe-dumbmerch \
                                --timeout=120s

                            PORT_FORWARD_LOG="/tmp/fe-dumbmerch-port-forward.log"

                            sudo kubectl -n frontend port-forward \
                                service/fe-dumbmerch \
                                18080:3000 \
                                > "\${PORT_FORWARD_LOG}" 2>&1 &

                            PORT_FORWARD_PID=\$!

                            trap "kill \${PORT_FORWARD_PID} 2>/dev/null || true" EXIT

                            sleep 5

                            wget \
                                --spider \
                                --timeout=10 \
                                --tries=10 \
                                --waitretry=3 \
                                --retry-connrefused \
                                http://localhost:18080

                            kill \${PORT_FORWARD_PID} 2>/dev/null || true
EOF
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '=== CI/CD FE-DUMBMERCH:PRODUCTION SUCCESS ==='
        }

        failure {
            echo '=== CI/CD FE-DUMBMERCH:PRODUCTION FAILED ==='
        }
    }
}